<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  OpenFPS Checkstyle Configuration
  supplements STYLE.md with enforceable rules
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="warning"/>
    <property name="fileExtensions" value="java"/>

    <!-- Suppress generated files -->
    <module name="SuppressWarningsFilter"/>

    <!-- TreeWalker modules -->
    <module name="TreeWalker">

        <!-- Naming Conventions -->
        <module name="ConstantName">
            <property name="format" value="^[A-Z][A-Z0-9]*(_[A-Z0-9]+)*$"/>
        </module>
        <module name="MemberName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
            <property name="applyToProtected" value="true"/>
            <property name="applyToPackage" value="true"/>
        </module>
        <module name="MethodName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
        </module>
        <module name="PackageName">
            <property name="format" value="^[a-z][a-z0-9]*(\.[a-z][a-z0-9]*)*$"/>
        </module>
        <module name="ParameterName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
        </module>
        <module name="LocalVariableName">
            <property name="format" value="^[a-z][a-zA-Z0-9]*$"/>
        </module>

        <!-- Braces — K&R style: on own lines -->
        <module name="LeftCurly">
            <property name="option" value="nl"/>
            <property name="id" value="LeftCurlyMethodDef"/>
            <property name="tokens" value="CLASS_DEF,INTERFACE_DEF,METHOD_DEF,CTOR_DEF"/>
        </module>
        <module name="RightCurly">
            <property name="option" value="alone"/>
            <property name="tokens"
                value="CLASS_DEF,INTERFACE_DEF,ENUM_DEF,ANNOTATION_DEF,RECORD_DEF,METHOD_DEF,CTOR_DEF,COMPACT_CTOR_DEF,STATIC_INIT,INSTANCE_INIT,LITERAL_IF,LITERAL_ELSE,LITERAL_FOR,LITERAL_WHILE,LITERAL_DO,LITERAL_TRY,LITERAL_CATCH,LITERAL_FINALLY"/>
        </module>

        <!-- Whitespace -->
        <module name="GenericWhitespace"/>
        <module name="MethodParamPad"/>
        <module name="NoWhitespaceAfter">
            <property name="tokens" value="BNOT,DOT,LNOT"/>
        </module>
        <module name="NoWhitespaceBefore">
            <property name="tokens" value="SEMI,POST_DEC,POST_INC"/>
        </module>
        <module name="ParenPad"/>
        <module name="TypecastParenPad"/>
        <module name="WhitespaceAfter">
            <property name="tokens" value="COMMA,SEMI,TYPECAST"/>
        </module>
        <module name="WhitespaceAround">
            <property name="tokens"
                value="ASSIGN,BAND,BAND_ASSIGN,BOR,BOR_ASSIGN,BSR,BSR_ASSIGN,BXOR,BXOR_ASSIGN,COLON,DIV,DIV_ASSIGN,EQUAL,GE,GT,LAND,LE,LITERAL_ASSERT,LITERAL_CATCH,LITERAL_DO,LITERAL_ELSE,LITERAL_FINALLY,LITERAL_FOR,LITERAL_IF,LITERAL_RETURN,LITERAL_SYNCHRONIZED,LITERAL_TRY,LITERAL_WHILE,STAR,STAR_ASSIGN,LAMBDA"/>
        </module>

        <!-- Modifier checks -->
        <module name="ModifierOrder"/>
        <!-- Default tokens minus RESOURCE: STYLE.md § 3.1 asks for `final` on
             every local, and a try-with-resources variable is a local. The
             language makes it implicitly final; we still write it. -->
        <module name="RedundantModifier">
            <property name="tokens"
                value="METHOD_DEF,VARIABLE_DEF,ANNOTATION_FIELD_DEF,INTERFACE_DEF,CTOR_DEF,CLASS_DEF,ENUM_DEF"/>
        </module>

        <!-- Blocks -->
        <module name="AvoidNestedBlocks"/>

        <!-- Coding -->
        <!-- STYLE.md § 5.5 — the ternary operator is banned outright -->
        <module name="AvoidInlineConditionals"/>
        <module name="EmptyStatement"/>
        <module name="EqualsHashCode"/>
        <module name="IllegalInstantiation"/>
        <module name="InnerAssignment"/>
        <module name="MissingSwitchDefault"/>
        <module name="SimplifyBooleanExpression"/>
        <module name="SimplifyBooleanReturn"/>
        <module name="FallThrough"/>
        <module name="MultipleVariableDeclarations"/>

        <!-- Class Design -->
        <module name="FinalClass"/>
        <module name="HideUtilityClassConstructor"/>

        <!-- Miscellaneous -->
        <module name="UpperEll"/>
        <module name="ArrayTypeStyle"/>

        <!-- Javadoc — required on public/protected members -->
        <!-- STYLE.md § 5.1 requires a Javadoc block on every non-private
             method; it does not require exhaustive @param/@return tags.
             This validates that the tags you DO write are correct and match
             the signature, without forcing boilerplate onto one-line
             accessors. Tighten by flipping these to false if § 5.1 changes. -->
        <module name="JavadocMethod">
            <property name="accessModifiers" value="public"/>
            <property name="allowMissingParamTags" value="true"/>
            <property name="allowMissingReturnTag" value="true"/>
        </module>
        <module name="JavadocType">
            <property name="scope" value="public"/>
        </module>
        <module name="JavadocVariable">
            <property name="scope" value="public"/>
        </module>
        <module name="JavadocStyle">
            <property name="checkFirstSentence" value="true"/>
        </module>

    </module>
</module>
