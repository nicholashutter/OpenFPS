# Gradle
.gradle/
build/
bin/

# Eclipse / VS Code / IntelliJ
*.class
*.jar
*.war
*.ear
*.log
*.iml
.idea/
.vscode/
*.ipr
*.iws
*.iws.local
out/
.DS_Store
Thumbs.db

# OS
*.bak
*.tmp
*~

# Checkstyle
build/reports/checkstyle/
build/checkstyle-cache

# Javadoc
apidocs/

# Game data — never committed. Fetched via `gradlew fetchAssets` and mirrored
# from our own pinned release. See docs/ASSETS.md.
#   raw/   — unprocessed upstream downloads
#   cache/ — the verified, preprocessed payload the engine loads
assets/raw/
assets/cache/
# Belt-and-braces against an accidental multi-megabyte commit. A deliberate
# small test fixture can still be added with `git add -f`.
*.glb
*.gltf

# AI agent worktrees and session state. Each worktree carries a full build/
# directory; left untracked-but-unignored this is ~120 MB one `git add -A` away
# from entering history.
.claude/

# Android / Mobile
*.apk
*.aab
# Unpacked by `copyAndroidNatives` from the classified gdx-platform jars on
# every build. Generated output, one .so per ABI — not source, and it grows
# with each architecture added.
android/src/main/jniLibs/
build/intermediates/
build/outputs/

# The Gradle wrapper MUST be committed — a fresh clone has no other way to
# bootstrap the right Gradle version. These negations have to sit AFTER the
# `*.jar` rule above: git applies the last matching pattern, so putting them
# at the top (as they used to be) left the wrapper JAR untracked.
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties
