# Gradle
.gradle/
build/
bin/

# Eclipse / VS Code / IntelliJ
*.class
*.jar
*.war
*.ear
*.log
*.iml
.idea/
# .vscode/* rather than .vscode/, because git does not look inside an ignored
# DIRECTORY and a negation for a file within one never matches. Spelling it as
# the contents is what lets the one workspace file below be committed.
.vscode/*
# tasks.json is project configuration, not personal state: it is what makes
# `run-desktop.ps1` and `run-android.ps1` one command-palette entry each, and a
# fresh clone with no tasks.json has to be told about them in prose instead.
# settings.json stays ignored -- it holds absolute JDK paths valid on exactly
# one machine -- and so does launch.json, which is a per-developer debugger set.
!.vscode/tasks.json
*.ipr
*.iws
*.iws.local
out/
.DS_Store
Thumbs.db

# OS
*.bak
*.tmp
*~

# Checkstyle
build/reports/checkstyle/
build/checkstyle-cache

# Javadoc
apidocs/

# Game data — never committed. Fetched via `gradlew fetchAssets` and mirrored
# from our own pinned release. See docs/ASSETS.md.
#   raw/   — unprocessed upstream downloads
#   cache/ — the verified, preprocessed payload the engine loads
assets/raw/
assets/cache/
#   gltf/   — the unpacked upstream models `gradlew :tools:convertModels` reads
#   models/ — the converted .ofm output it writes
assets/gltf/
assets/models/
*.ofm
# Belt-and-braces against an accidental multi-megabyte commit. A deliberate
# small test fixture can still be added with `git add -f`.
*.glb
*.gltf

# AI agent worktrees and session state. Each worktree carries a full build/
# directory; left untracked-but-unignored this is ~120 MB one `git add -A` away
# from entering history.
.claude/

# Android / Mobile
# Machine-local SDK path. settings.gradle.kts reads this (or ANDROID_HOME) to
# decide whether to include :android at all — so it must exist locally and must
# never be committed, since the absolute path is valid on exactly one machine.
local.properties
*.apk
*.aab
# Unpacked by `copyAndroidNatives` from the classified gdx-platform jars on
# every build. Generated output, one .so per ABI — not source, and it grows
# with each architecture added.
android/src/main/jniLibs/
build/intermediates/
build/outputs/

# The Gradle wrapper MUST be committed — a fresh clone has no other way to
# bootstrap the right Gradle version. These negations have to sit AFTER the
# `*.jar` rule above: git applies the last matching pattern, so putting them
# at the top (as they used to be) left the wrapper JAR untracked.
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties
