  The package name is not declared here — AGP 8 takes it from the
  `namespace` property in build.gradle.kts and errors if both are set.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- LAN peer discovery broadcasts on DEFAULT_NET_PORT. Without
         INTERNET the UDP socket cannot even bind. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Receiving UDP broadcast on Android requires holding a
         MulticastLock, which requires this permission. See
         net/README.md section 9 (NAT traversal). -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- OpenGL ES 3.0. libGDX's Android backend falls back to 2.0, but the
         engine's shader path targets 3.0 so it is declared required. -->
    <uses-feature
        android:glEsVersion="0x00030000"
        android:required="true" />

    <!--
      largeHeap, and this one is measured rather than precautionary.

      The renderer is a SOFTWARE rasterizer, so every buffer a GPU would keep
      in VRAM is a Java array here, sized to the physical surface. At the
      emulator's 2400x1080 that is a 10.4 MB colour int[], a 10.4 MB depth
      buffer, and another 10.4 MB int[] the presenter uploads from — 31 MB of
      arrays that a desktop game would never charge to its heap at all, plus
      about 21 MB of decoded model textures.

      Without this the app is capped at dalvik.vm.heapgrowthlimit, and the
      first run on the emulator logged TWO OutOfMemoryErrors on the presenter's
      10,368,012-byte scratch array before the heap had grown enough to let the
      third attempt through. It survived, which is the worrying part: the
      symptom was a couple of dropped frames at startup and an error the player
      never sees. A device with a tighter growth limit — most mid-range phones
      are at 96-128 MB, not this emulator's 192 — takes the same path and dies.

      This is a ceiling, not a reservation: the heap still grows on demand and
      an app that needs 40 MB still uses 40 MB.
    -->
    <application
        android:label="OpenFPS"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:allowBackup="false"
        android:supportsRtl="true">

        <activity
            android:name="com.openfps.android.AndroidLauncher"
            android:exported="true"
            android:screenOrientation="landscape"
            android:launchMode="singleTask"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
